# PostgreSQL connection string ที่ Prisma ใช้เชื่อมต่อ
DATABASE_URL="postgresql://kk4_user:kk4_password@localhost:5432/kk4_doc_record?schema=public"

# Fastify server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT secret (เปลี่ยนเป็นค่าจริงก่อน deploy — ห้าม commit ค่าจริงเข้า git)
JWT_SECRET=change-this-to-a-real-secret-before-deploy

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
